<?xml version="1.0" encoding="UTF-8"?>
<!--
  Single-node Ignite config with thin-client connector enabled.
  Caches REGISTER / TURN_DOC_CUR / CLIENT / CURRENCY / DAY_BALANCES /
         DIVISION / INCOME_SALDO / CB_RATE / CASH_SYMBOL_DOC
  are auto-created on first SQL "CREATE TABLE" issued by smoke scripts.
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
            http://www.springframework.org/schema/beans
            http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="ignite.cfg" class="org.apache.ignite.configuration.IgniteConfiguration">

        <property name="clientConnectorConfiguration">
            <bean class="org.apache.ignite.configuration.ClientConnectorConfiguration">
                <property name="host" value="0.0.0.0"/>
                <property name="port" value="10800"/>
            </bean>
        </property>

        <property name="discoverySpi">
            <bean class="org.apache.ignite.spi.discovery.tcp.TcpDiscoverySpi">
                <property name="ipFinder">
                    <bean class="org.apache.ignite.spi.discovery.tcp.ipfinder.vm.TcpDiscoveryVmIpFinder">
                        <property name="addresses">
                            <list>
                                <value>127.0.0.1:47500</value>
                            </list>
                        </property>
                    </bean>
                </property>
            </bean>
        </property>

    </bean>

</beans>
